# Runtime
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_ENV=development
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000

# PostgreSQL (used by Docker Compose; local settings can use the same URL)
DATABASE_URL=postgresql://lacrei:lacrei@localhost:5432/lacrei
POSTGRES_DB=lacrei
POSTGRES_USER=lacrei
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer

# HTTPS/security flags (true in staging/production)
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0

# Gunicorn
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=30
WEB_CONCURRENCY=3
